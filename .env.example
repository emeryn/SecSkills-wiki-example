# Every variable is optional: `docker compose up` works without a .env file.
# Copy to .env and uncomment only what you need to change. Never put secrets here:
# secrets are generated by the `init` service into the `secrets` volume.

# --- Compose ---
# Address and port published by the reverse proxy (HTTPS). Use 0.0.0.0 to expose on the network.
# FRONTEND_BIND_ADDRESS=127.0.0.1
# FRONTEND_PORT=8443
# Image names (set to a registry path when deploying signed images).
# BACKEND_IMAGE=wiki-backend
# FRONTEND_IMAGE=wiki-frontend
# DB_IMAGE=wiki-db

# --- Backend ---
# URL users open (scheme, host, port). Used for CSRF origin checks, WebAuthn and emailed links.
# Defaults to https://localhost:${FRONTEND_PORT}.
# BACKEND_PUBLIC_URL=https://wiki.example.com
# Host names and IPs in the generated self-signed certificate (comma-separated, first run only).
# BACKEND_TLS_HOSTNAMES=localhost,127.0.0.1
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# BACKEND_LOG_LEVEL=INFO
# production | development | test
# BACKEND_ENVIRONMENT=production
# Number of reverse proxies in front of the backend; client IP is read from X-Forwarded-For accordingly.
# BACKEND_TRUSTED_PROXY_COUNT=1
# Directory holding the generated secrets (file secrets provider).
# BACKEND_SECRETS_DIR=/run/secrets
# BACKEND_DB_HOST=db
# BACKEND_DB_PORT=5432
# BACKEND_DB_POOL_SIZE=5
# Maximum request body accepted by the API, in bytes.
# BACKEND_MAX_REQUEST_BODY_BYTES=2097152
# Serve /api/v1/openapi.json (keep false in production).
# BACKEND_API_DOCS_ENABLED=false
# Session lifetimes. Administrators are capped at 60 min idle / 8 h absolute.
# BACKEND_SESSION_IDLE_MINUTES=480
# BACKEND_SESSION_ABSOLUTE_HOURS=168
# BACKEND_ADMIN_SESSION_IDLE_MINUTES=60
# BACKEND_ADMIN_SESSION_ABSOLUTE_HOURS=8
# Window after a password/MFA check during which sensitive actions need no new confirmation.
# BACKEND_REAUTH_WINDOW_MINUTES=5
# Interval of the worker's hygiene jobs (expired sessions, tokens, idempotency keys).
# BACKEND_WORKER_INTERVAL_SECONDS=600
# Accounts without a sign-in for this many days are disabled (0: never). The last admin is kept.
# BACKEND_INACTIVE_ACCOUNT_DAYS=180
# Encrypted backups (database + attachments) in the `backups` volume, every N hours (0: only
# `make backup`). The key is app/backup.key in the `secrets` volume: keep a copy elsewhere.
# BACKEND_BACKUP_INTERVAL_HOURS=24
# BACKEND_BACKUP_RETENTION_COUNT=14
# BACKEND_BACKUPS_DIR=/var/lib/wiki/backups
# Attachment storage (a volume) and maximum file size in bytes.
# BACKEND_ATTACHMENTS_DIR=/var/lib/wiki/attachments
# BACKEND_MAX_ATTACHMENT_BYTES=10485760

# --- Email (SMTPS, optional; also start with -f deploy/compose.egress.yml) ---
# Without SMTP, administrators create password reset links from the Users page.
# SMTP can also be configured in Admin > Settings > Email; these variables take precedence and
# make that page read-only. Syslog, webhooks and notifications are configured in the UI only.
# BACKEND_SMTP_HOST=smtp.example.com
# BACKEND_SMTP_PORT=465
# BACKEND_SMTP_FROM=wiki@example.com
# BACKEND_SMTP_USERNAME=wiki
# Path inside the container to a file holding the SMTP password (never the password itself).
# BACKEND_SMTP_PASSWORD_FILE=/run/secrets/app/smtp_password

# --- Single sign-on (optional) ---
# Each variable can instead be set in Admin > Settings; a variable set here wins and is shown
# read-only there. Invalid values stop the application at startup. Secrets only as *_FILE
# (see deploy/compose.sso.yml); lists comma-separated; group mappings as JSON.
# Outbound access to the IdP or directory needs -f deploy/compose.egress.yml.
# BACKEND_OIDC_ENABLED=true
# BACKEND_OIDC_DISPLAY_NAME=Example ID
# https only; register <BACKEND_PUBLIC_URL>/api/v1/auth/oidc/callback as redirect URI.
# BACKEND_OIDC_ISSUER=https://id.example.com/realms/wiki
# BACKEND_OIDC_CLIENT_ID=wiki
# BACKEND_OIDC_CLIENT_SECRET_FILE=/run/sso/oidc_client_secret
# BACKEND_OIDC_SCOPES=openid,profile,email,groups
# RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384, ES512 or EdDSA (never none/HS*).
# BACKEND_OIDC_ID_TOKEN_ALGORITHM=RS256
# BACKEND_OIDC_USERNAME_CLAIM=preferred_username
# BACKEND_OIDC_EMAIL_CLAIM=email
# BACKEND_OIDC_NAME_CLAIM=name
# BACKEND_OIDC_GROUPS_CLAIM=groups
# BACKEND_OIDC_AUTO_PROVISION=true
# BACKEND_OIDC_GROUP_MAPPING=[{"group": "wiki-editors", "space": "engineering", "role": "editor"}]
# Members of these groups are administrators (second factor still required), as JSON.
# BACKEND_OIDC_ADMIN_GROUPS=["wiki-admins"]
# BACKEND_OIDC_CA_FILE=/run/sso/idp-ca.pem
# ldaps://host:636, or ldap://host:389 with BACKEND_LDAP_START_TLS=true.
# BACKEND_LDAP_ENABLED=true
# BACKEND_LDAP_URL=ldaps://ldap.example.com
# BACKEND_LDAP_START_TLS=false
# BACKEND_LDAP_BIND_DN=cn=wiki,ou=services,dc=example,dc=com
# BACKEND_LDAP_BIND_PASSWORD_FILE=/run/sso/ldap_bind_password
# BACKEND_LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
# BACKEND_LDAP_USER_FILTER=(&(objectClass=person)(uid={username}))
# BACKEND_LDAP_USERNAME_ATTRIBUTE=uid
# BACKEND_LDAP_EMAIL_ATTRIBUTE=mail
# BACKEND_LDAP_NAME_ATTRIBUTE=cn
# BACKEND_LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
# BACKEND_LDAP_GROUP_FILTER=(&(objectClass=groupOfNames)(member={user_dn}))
# BACKEND_LDAP_AUTO_PROVISION=true
# BACKEND_LDAP_GROUP_MAPPING=[{"group": "cn=eng,ou=groups,dc=example,dc=com", "space": "engineering", "role": "editor"}]
# BACKEND_LDAP_ADMIN_GROUPS=["cn=wiki-admins,ou=groups,dc=example,dc=com"]
# BACKEND_LDAP_CA_FILE=/run/sso/ldap-ca.pem

# --- Build (offline mirrors) ---
# NPM_REGISTRY=https://nexus.example.com/repository/npm/
# UV_INDEX_URL=https://nexus.example.com/repository/pypi/simple
